{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Envoy Gateway Coraza WAF detections and logs",
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum(increase(waf_tx_total[$__range]))",
          "legendFormat": "detections",
          "refId": "A"
        }
      ],
      "title": "WAF transactions",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum(increase(waf_tx_blocked[$__range]))",
          "legendFormat": "blocked",
          "refId": "A"
        }
      ],
      "title": "Blocked transactions",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (pod) (rate(waf_tx_total[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "Detection rate by gateway pod",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum by (pod) (increase(waf_tx_total[$__range]))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Detections by gateway pod",
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "options": {
        "deduplication": {
          "enabled": true
        },
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "sortOrder": "Descending",
        "wrapLines": false
      },
      "targets": [
        {
          "expr": "{namespace=\"envoy-gateway\"} |= \"Coraza:\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Coraza detection logs",
      "type": "logs"
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "envoy-gateway",
    "waf",
    "coraza"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "title": "Envoy Gateway WAF",
  "uid": "envoy-gateway-waf",
  "version": 1
}
