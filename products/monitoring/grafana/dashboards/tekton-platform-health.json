{
  "uid": "tekton-platform-health",
  "title": "Tekton / Platform Health",
  "tags": [
    "tekton",
    "ci",
    "community"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Scrape targets",
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{namespace=~\"tekton|tekton-operator\",job=~\"tekton-.*|tekton/tekton-triggers-webhook\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "__name__": true,
              "endpoint": true,
              "instance": true,
              "container": true,
              "service": true,
              "pod": false,
              "eventlistener": true
            },
            "renameByName": {
              "Value": "Up",
              "job": "job",
              "namespace": "namespace"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Up"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "UP",
                        "color": "green",
                        "index": 0
                      },
                      "0": {
                        "text": "DOWN",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Up",
            "desc": true
          }
        ]
      },
      "description": "Per-pod scrape status, including the Trigger webhook PodMonitor. Missing targets do not produce an up series."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Controller processing latency p95 by queue",
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 10,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (name,le) (rate(kn_workqueue_process_duration_seconds_bucket{namespace=\"tekton-operator\",job=\"tekton-pipelines-controller\"}[$__rate_interval])))",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": false,
            "pointSize": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Tekton v1.15 Knative workqueue processing histogram; replaces the legacy reconciler latency metric."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Controller workqueue retries per second",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name)(rate(kn_workqueue_retries_total{namespace=\"tekton-operator\",job=\"tekton-pipelines-controller\"}[$__rate_interval]))",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": false,
            "pointSize": 5
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Queue retry rate; retries can include normal requeues and are not an error rate."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Controller workqueue depth",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name)(kn_workqueue_depth{namespace=\"tekton-operator\",job=\"tekton-pipelines-controller\"})",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": false,
            "pointSize": 5
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Items waiting for reconcile. Sustained growth = controller saturation."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Available control-plane replicas",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (namespace,deployment)(kube_deployment_status_replicas_available{namespace=~\"tekton|tekton-operator\",deployment=~\"tekton-.*\"})",
          "legendFormat": "{{namespace}}/{{deployment}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": false,
            "pointSize": 5
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Two available replicas are expected for each Tekton deployment. Replaces the unused Results API panel."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Control-plane container restarts (interval)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace,pod)(increase(kube_pod_container_status_restarts_total{namespace=~\"tekton|tekton-operator\",pod=~\"tekton-.*\",container!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 85,
            "spanNulls": false,
            "pointSize": 5,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cancelled"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Container restarts across both Tekton namespaces. Replaces the unused Results watcher panel."
    }
  ],
  "description": "Adapted from KubeRocketCI / epam/edp-cluster-add-ons at b6892097eca7f0087806f22843f7bddc1d220c07 (Apache-2.0; see tekton-dashboards.LICENSE). Source: https://github.com/epam/edp-cluster-add-ons/blob/b6892097eca7f0087806f22843f7bddc1d220c07/clusters/core/addons/tekton-monitoring/files/tekton-platform-health.json. Modified for gerador / Tekton v1.15: scrape-label collisions, HA-safe current counts, current workqueue and scheduling histograms, Prometheus datasource, and disabled Results. Workload history appears after builds run; missing telemetry is not a successful build.",
  "links": [
    {
      "type": "link",
      "title": "Pinned upstream source",
      "url": "https://github.com/epam/edp-cluster-add-ons/blob/b6892097eca7f0087806f22843f7bddc1d220c07/clusters/core/addons/tekton-monitoring/files/tekton-platform-health.json",
      "targetBlank": true
    }
  ]
}
