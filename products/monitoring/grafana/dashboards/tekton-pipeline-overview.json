{
  "uid": "tekton-pipeline-overview",
  "title": "Tekton / Pipeline Overview",
  "tags": [
    "tekton",
    "ci",
    "community"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(tekton_pipelines_controller_pipelinerun_duration_seconds_count, exported_namespace)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*",
        "label": "Build namespace"
      },
      {
        "name": "pipeline",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(tekton_pipelines_controller_pipelinerun_duration_seconds_count{exported_namespace=~\"${namespace:regex}\"}, pipeline)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*",
        "label": "PIPELINE"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Runs (range)",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum(increase(tekton_pipelines_controller_pipelinerun_duration_seconds_count{namespace=\"tekton-operator\",job=\"tekton-pipelines-controller\",exported_namespace=~\"${namespace:regex}\", pipeline=~\"${pipeline:regex}\"}[$__range])))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Success rate",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(tekton_pipelines_controller_pipelinerun_duration_seconds_count{namespace=\"tekton-operator\",job=\"tekton-pipelines-controller\",exported_namespace=~\"${namespace:regex}\", pipeline=~\"${pipeline:regex}\", status=\"success\"}[$__range])) / (sum(increase(tekton_pipelines_controller_pipelinerun_duration_seconds_count{namespace=\"tekton-operator\",job=\"tekton-pipelines-controller\",exported_namespace=~\"${namespace:regex}\", pipeline=~\"${pipeline:regex}\"}[$__range])) > 0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "n/a",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failed runs (range)",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum(increase(tekton_pipelines_controller_pipelinerun_duration_seconds_count{namespace=\"tekton-operator\",job=\"tekton-pipelines-controller\",exported_namespace=~\"${namespace:regex}\", pipeline=~\"${pipeline:regex}\", status=~\"failed|error\"}[$__range])))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Timeouts (range)",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 15,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum(increase(tekton_pipelines_controller_pipelinerun_duration_seconds_count{namespace=\"tekton-operator\",job=\"tekton-pipelines-controller\",exported_namespace=~\"${namespace:regex}\", pipeline=~\"${pipeline:regex}\", reason=~\".*Timeout.*\"}[$__range])))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "PipelineRuns that hit their timeout rather than failing on their own."
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Running now",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (exported_namespace, pipeline) (tekton_pipelines_controller_running_pipelineruns{namespace=\"tekton-operator\",job=\"tekton-pipelines-controller\",exported_namespace=~\"${namespace:regex}\",pipeline=~\"${pipeline:regex}\",pipeline!=\"\"})) or (0 * max(tekton_pipelines_controller_running_pipelineruns{namespace=\"tekton-operator\",job=\"tekton-pipelines-controller\",exported_namespace=\"\"}))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Current runs in the selected build namespaces and pipelines. Each replica observes the same runs, so take max per namespace/pipeline before summing. The unlabelled cluster gauge supplies zero only while controller telemetry exists."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Pipeline runs by result",
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum by (status)(increase(tekton_pipelines_controller_pipelinerun_duration_seconds_count{namespace=\"tekton-operator\",job=\"tekton-pipelines-controller\",exported_namespace=~\"${namespace:regex}\", pipeline=~\"${pipeline:regex}\"}[$__rate_interval])))",
          "legendFormat": "{{status}}",
          "interval": "10m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 85,
            "spanNulls": false,
            "pointSize": 5,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cancelled"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Completed PipelineRuns per 10m interval, split by final status."
    },
    {
      "id": 7,
      "type": "piechart",
      "title": "Failure reasons (range)",
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(round(sum by (reason)(increase(tekton_pipelines_controller_pipelinerun_duration_seconds_count{namespace=\"tekton-operator\",job=\"tekton-pipelines-controller\",exported_namespace=~\"${namespace:regex}\", pipeline=~\"${pipeline:regex}\", status!=\"success\"}[$__range]))), \"reason\", \"unlabelled\", \"reason\", \"^$\")",
          "legendFormat": "{{reason}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*Timeout.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*[Cc]ancel.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value",
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "description": "Non-success PipelineRuns by failure class — separates broken builds (Failed) from an overloaded cluster (PipelineRunTimeout) and deliberate stops (Cancelled)."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Pipeline run duration (avg per interval)",
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pipeline)(increase(tekton_pipelines_controller_pipelinerun_duration_seconds_sum{namespace=\"tekton-operator\",job=\"tekton-pipelines-controller\",exported_namespace=~\"${namespace:regex}\", pipeline=~\"${pipeline:regex}\"}[$__rate_interval])) / (sum by (pipeline)(increase(tekton_pipelines_controller_pipelinerun_duration_seconds_count{namespace=\"tekton-operator\",job=\"tekton-pipelines-controller\",exported_namespace=~\"${namespace:regex}\", pipeline=~\"${pipeline:regex}\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{pipeline}}",
          "interval": "10m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "points",
            "lineWidth": 0,
            "fillOpacity": 0,
            "spanNulls": false,
            "pointSize": 9
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Mean duration of runs completed in each 10m interval, per pipeline. Isolated spikes are usually failures hanging until timeout, not a slowdown."
    },
    {
      "id": 9,
      "type": "table",
      "title": "Per-pipeline summary (range)",
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum by (pipeline)(increase(tekton_pipelines_controller_pipelinerun_duration_seconds_count{namespace=\"tekton-operator\",job=\"tekton-pipelines-controller\",exported_namespace=~\"${namespace:regex}\", pipeline=~\"${pipeline:regex}\"}[$__range])))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "sum by (pipeline)(increase(tekton_pipelines_controller_pipelinerun_duration_seconds_count{namespace=\"tekton-operator\",job=\"tekton-pipelines-controller\",exported_namespace=~\"${namespace:regex}\", pipeline=~\"${pipeline:regex}\", status=\"success\"}[$__range])) / (sum by (pipeline)(increase(tekton_pipelines_controller_pipelinerun_duration_seconds_count{namespace=\"tekton-operator\",job=\"tekton-pipelines-controller\",exported_namespace=~\"${namespace:regex}\", pipeline=~\"${pipeline:regex}\"}[$__range])) > 0)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.50, sum by (pipeline, le)(increase(tekton_pipelines_controller_pipelinerun_duration_seconds_bucket{namespace=\"tekton-operator\",job=\"tekton-pipelines-controller\",exported_namespace=~\"${namespace:regex}\", pipeline=~\"${pipeline:regex}\"}[$__range]))) and on(pipeline) (sum by (pipeline)(increase(tekton_pipelines_controller_pipelinerun_duration_seconds_count{namespace=\"tekton-operator\",job=\"tekton-pipelines-controller\",exported_namespace=~\"${namespace:regex}\", pipeline=~\"${pipeline:regex}\"}[$__range])) > 0)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.95, sum by (pipeline, le)(increase(tekton_pipelines_controller_pipelinerun_duration_seconds_bucket{namespace=\"tekton-operator\",job=\"tekton-pipelines-controller\",exported_namespace=~\"${namespace:regex}\", pipeline=~\"${pipeline:regex}\"}[$__range]))) and on(pipeline) (sum by (pipeline)(increase(tekton_pipelines_controller_pipelinerun_duration_seconds_count{namespace=\"tekton-operator\",job=\"tekton-pipelines-controller\",exported_namespace=~\"${namespace:regex}\", pipeline=~\"${pipeline:regex}\"}[$__range])) > 0)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "sum by (pipeline)(increase(tekton_pipelines_controller_pipelinerun_duration_seconds_sum{namespace=\"tekton-operator\",job=\"tekton-pipelines-controller\",exported_namespace=~\"${namespace:regex}\", pipeline=~\"${pipeline:regex}\"}[$__range])) / (sum by (pipeline)(increase(tekton_pipelines_controller_pipelinerun_duration_seconds_count{namespace=\"tekton-operator\",job=\"tekton-pipelines-controller\",exported_namespace=~\"${namespace:regex}\", pipeline=~\"${pipeline:regex}\"}[$__range])) > 0)",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "pipeline",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true
            },
            "renameByName": {
              "Value #A": "Runs",
              "Value #B": "Success rate",
              "Value #C": "p50 (typical)",
              "Value #D": "p95",
              "Value #E": "Avg duration"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Success rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p50 (typical)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Avg duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Runs",
            "desc": true
          }
        ]
      }
    }
  ],
  "description": "Adapted from KubeRocketCI / epam/edp-cluster-add-ons at b6892097eca7f0087806f22843f7bddc1d220c07 (Apache-2.0; see tekton-dashboards.LICENSE). Source: https://github.com/epam/edp-cluster-add-ons/blob/b6892097eca7f0087806f22843f7bddc1d220c07/clusters/core/addons/tekton-monitoring/files/tekton-pipeline-overview.json. Modified for gerador / Tekton v1.15: scrape-label collisions, HA-safe current counts, current workqueue and scheduling histograms, Prometheus datasource, and disabled Results. Workload history appears after builds run; missing telemetry is not a successful build.",
  "links": [
    {
      "type": "link",
      "title": "Pinned upstream source",
      "url": "https://github.com/epam/edp-cluster-add-ons/blob/b6892097eca7f0087806f22843f7bddc1d220c07/clusters/core/addons/tekton-monitoring/files/tekton-pipeline-overview.json",
      "targetBlank": true
    }
  ]
}
